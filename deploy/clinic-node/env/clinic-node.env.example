# Clinic Node environment — generated by install/install.sh
# Never commit real secrets. Copy from this example only for documentation.
# Security Wave 4: unique per-node secrets + PHI encryption at rest.

ENVIRONMENT=clinic-node
DEBUG=false
DOMAIN=sante-locale
ALLOWED_HOSTS=sante-locale,localhost,127.0.0.1,backend,proxy
TRUSTED_PROXY_HOSTS=proxy,127.0.0.1,localhost,backend
FRONTEND_URL=https://sante-locale

POSTGRES_USER=sante
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_16
POSTGRES_DB=sante

SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_32_PLUS_CHARS
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_32_PLUS_CHARS
REMINDER_RESPOND_TOKEN=REPLACE_WITH_STRONG_RANDOM_32_PLUS_CHARS

# Must be unique and different from JWT_SECRET
CLINIC_NODE_LICENSE_SECRET=REPLACE_WITH_UNIQUE_LICENSE_SECRET
CLINIC_NODE_UPDATE_SECRET=REPLACE_WITH_UNIQUE_UPDATE_SECRET

# Fernet key for PHI attachments (required)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ATTACHMENT_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
REQUIRE_ATTACHMENT_ENCRYPTION=true

NODE_ID=
CLINIC_ID=
CLINIC_DATA_DIR=./data

HTTP_PORT=80
HTTPS_PORT=443

# bridge (default) | host (lab only — also set CLINIC_NODE_ALLOW_HOST_NETWORK=true)
CLINIC_NODE_NETWORK=bridge
CLINIC_NODE_ALLOW_HOST_NETWORK=false

DISABLE_API_DOCS=true
ENABLE_PILOT_SEED=false
ENABLE_STARTUP_TEST_USER=false
ENABLE_STARTUP_SEED=false
ENABLE_DEMO_CLINIC_SEED=false
ENABLE_LAN_DEV=false
BYPASS_AVAILABILITY_VALIDATION=false
