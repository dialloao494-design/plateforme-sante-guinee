# Backend API — copy to deploy/env/.env.backend (never commit secrets)

ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
DOMAIN=sante.example.com
ALLOWED_HOSTS=sante.example.com,backend
LOG_LEVEL=INFO
LOG_FORMAT=json

# Set by docker-compose for the db service:
# DATABASE_URL=postgresql://sante:CHANGE_ME@db:5432/sante

SECRET_KEY=GENERATE_WITH_python_-c_import_secrets_secrets_token_urlsafe_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — public site URL(s), comma-separated
CORS_ORIGINS=https://sante.example.com
FRONTEND_URL=https://sante.example.com
FRONTEND_PRODUCTION_URL=https://sante.example.com

ENABLE_LAN_DEV=false
ENABLE_PILOT_SEED=false
ENABLE_DEMO_CLINIC_SEED=false
ENABLE_STARTUP_TEST_USER=false
ENABLE_STARTUP_SEED=false
BYPASS_AVAILABILITY_VALIDATION=false

# Rate limiting (production defaults applied when ENVIRONMENT=production)
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN=30/minute
RATE_LIMIT_REGISTER=5/minute

# Teleconsultation provider: stub | jitsi | daily | twilio
TELECONSULT_PROVIDER=jitsi
JITSI_APP_ID=
JITSI_APP_SECRET=
JITSI_DOMAIN=meet.jit.si
# JWT works on self-hosted Jitsi / 8x8 — not on public meet.jit.si

# Monitoring (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
DAILY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# SMTP (transactional notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sante.example.com
SMTP_TLS=true

# Optional notification channels
SMS_PROVIDER=
PUSH_PROVIDER=
