[Unit]
Description=Plateforme Santé Guinée — Docker Compose (staging/production)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/plateforme-sante-guinee
EnvironmentFile=-/opt/plateforme-sante-guinee/.env.staging
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.staging.yml --env-file .env.staging up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.staging.yml --env-file .env.staging down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
