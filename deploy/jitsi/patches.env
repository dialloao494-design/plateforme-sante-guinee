# Applied on top of docker-jitsi-meet/.env by scripts/start_jitsi_dev.ps1
PUBLIC_URL=https://127.0.0.1:8443
HTTP_PORT=8000
HTTPS_PORT=8443
TZ=Europe/Paris

ENABLE_AUTH=0
ENABLE_GUESTS=1
ENABLE_LOBBY=0
ENABLE_PREJOIN_PAGE=0
ENABLE_WELCOME_PAGE=0
ENABLE_RECORDING=0
ENABLE_TRANSCRIPTIONS=0
ENABLE_XMPP_WEBSOCKET=1
ENABLE_COLIBRI_WEBSOCKET=1

# Allow iframe embed from app (localhost + Cloudflare tunnels)
DISABLE_CONTENT_SECURITY_POLICY=1
