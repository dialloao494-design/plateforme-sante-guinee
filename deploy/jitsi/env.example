# Copied into docker-jitsi-meet/.env by scripts/start_jitsi_dev.ps1
CONFIG=~/.jitsi-meet-cfg
PUBLIC_URL=https://127.0.0.1:8443
HTTP_PORT=8000
HTTPS_PORT=8443
TZ=UTC

# Open room — no OAuth, no lobby (required for embedded teleconsultation)
ENABLE_AUTH=0
ENABLE_GUESTS=1
ENABLE_LOBBY=0
ENABLE_PREJOIN_PAGE=0
ENABLE_WELCOME_PAGE=0
ENABLE_RECORDING=0
ENABLE_TRANSCRIPTIONS=0

# Let iframe embed from localhost dev servers
ENABLE_XMPP_WEBSOCKET=1
ENABLE_COLIBRI_WEBSOCKET=1

# Passwords are generated by start_jitsi_dev.ps1 (gen-passwords.sh)
# JICOFO_AUTH_PASSWORD=
# JVB_AUTH_PASSWORD=
# JIGASI_XMPP_PASSWORD=
# JIBRI_RECORDER_PASSWORD=
# JIBRI_XMPP_PASSWORD=
