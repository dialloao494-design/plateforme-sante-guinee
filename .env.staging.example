# Staging VPS — copy to .env.staging on the server
# docker compose -f docker-compose.yml -f docker-compose.staging.yml --env-file .env.staging up -d --build

DOMAIN=staging.sante.example.com
HTTP_PORT=80

POSTGRES_USER=sante
POSTGRES_PASSWORD=CHANGE_ME_STAGING_PASSWORD
POSTGRES_DB=sante

ENVIRONMENT=staging
ENABLE_PILOT_SEED=true
ALLOWED_HOSTS=staging.sante.example.com,backend
TRUSTED_PROXY_HOSTS=127.0.0.1,backend
REMINDER_RESPOND_TOKEN=GENERATE_WITH_openssl_rand_hex_32

VITE_API_URL=/api
VITE_SAME_ORIGIN_API=true
VITE_TELECONSULT_PROVIDER=jitsi
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

CERTBOT_EMAIL=admin@sante.example.com
