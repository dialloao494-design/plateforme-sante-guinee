# Root compose / VPS — copy to .env.production on the server
# docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Public domain ---
DOMAIN=sante.example.com
HTTP_PORT=80

# --- PostgreSQL (docker internal) ---
POSTGRES_USER=sante
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=sante

# --- Application ---
ENVIRONMENT=production
DEBUG=false
ENABLE_PILOT_SEED=false
ENABLE_STARTUP_TEST_USER=false
ENABLE_STARTUP_SEED=false
ENABLE_DEMO_CLINIC_SEED=false
BYPASS_AVAILABILITY_VALIDATION=false
ALLOWED_HOSTS=sante.example.com,backend
TRUSTED_PROXY_HOSTS=127.0.0.1,backend
JWT_SECRET=CHANGE_ME_STRONG_JWT_SECRET_32_CHARS_MIN
SECRET_KEY=CHANGE_ME_STRONG_JWT_SECRET_32_CHARS_MIN
REMINDER_RESPOND_TOKEN=CHANGE_ME_STRONG_REMINDER_TOKEN_32_CHARS_MIN
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- WhatsApp Cloud API (reminders) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
ENABLE_REMINDER_CRON=true

# --- Frontend build (must match DOMAIN) ---
VITE_API_URL=https://sante.example.com/api
VITE_TELECONSULT_PROVIDER=jitsi

# --- Certbot contact ---
CERTBOT_EMAIL=admin@sante.example.com
# Public owner creation is disabled by default. Provision the owner with deployment
# secrets/CLI; enable this only for a tightly controlled first-deploy window.
ALLOW_PUBLIC_PLATFORM_OWNER_SETUP=false
