# ========================================
# HEALTHCARE PLATFORM - PRODUCTION ENVIRONMENT
# ========================================
# Copy this file to .env and fill in your production values
# NEVER commit the .env file with real secrets!

# ========================================
# APPLICATION ENVIRONMENT
# ========================================
DEBUG=False
HOST=0.0.0.0
PORT=8000

# ========================================
# DATABASE CONFIGURATION
# ========================================
# PostgreSQL (recommended for production)
# Format: postgresql://username:password@host:port/dbname
# For Render.com: Automatically provided when you create PostgreSQL service
# For Railway.app: Use ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# ========================================
# JWT & SECURITY
# ========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MUST be strong random value in production!
SECRET_KEY=your-strong-random-secret-key-generated-by-secrets-module

# JWT algorithm (HS256 = HMAC SHA256)
ALGORITHM=HS256

# Token expiration time in minutes (60 = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ========================================
# STRIPE PAYMENT CONFIGURATION
# ========================================
# LIVE KEYS (from https://dashboard.stripe.com/apikeys)
# Switch from test keys (sk_test_...) to live keys (sk_live_...)

# Stripe Secret Key (NEVER expose to public)
STRIPE_SECRET_KEY=sk_live_your_actual_stripe_secret_key

# Stripe Publishable Key (safe to expose in frontend)
# Get from Stripe Dashboard
STRIPE_PUBLISHABLE_KEY=pk_live_your_actual_stripe_publishable_key

# Stripe Webhook Secret (from https://dashboard.stripe.com/webhooks)
# Create webhook with endpoint: https://your-backend-url/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_from_stripe

# ========================================
# CORS & FRONTEND CONFIGURATION
# ========================================
# Frontend production URL (where React app is deployed)
# Used for CORS and redirect URLs
FRONTEND_PRODUCTION_URL=https://your-frontend-domain.vercel.app

# ========================================
# OPTIONAL: FEATURE FLAGS
# ========================================
# Set to true to skip availability validation (use with caution)
BYPASS_AVAILABILITY_VALIDATION=false

# ========================================
# OPTIONAL: EMAIL NOTIFICATIONS (Future Use)
# ========================================
# SENDGRID_API_KEY=sg_...
# NOTIFICATION_EMAIL_FROM=noreply@yourdomain.com

# ========================================
# OPTIONAL: LOGGING & MONITORING (Future Use)
# ========================================
# SENTRY_DSN=https://...
# LOG_LEVEL=INFO
