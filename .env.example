# ========================================
# HEALTHCARE PLATFORM - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file with real secrets

# ========================================
# APPLICATION ENVIRONMENT
# ========================================
# Set to True for development only (enables debug mode, verbosity)
DEBUG=False

# Phone + laptop on same Wi-Fi: set true or start backend with .\scripts\run_local_backend.ps1 -Lan
ENABLE_LAN_DEV=false

# Pilot accounts (dr.amu@example.com / test.patient@example.com) — true for local dev
ENABLE_PILOT_SEED=true

# Server binding
HOST=0.0.0.0
PORT=8000

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Development (SQLite - easier local setup):
DATABASE_URL=sqlite:///./sante.db

# Production (PostgreSQL - recommended):
# DATABASE_URL=postgresql://username:password@localhost:5432/sante_production

# Database lifecycle flags (safe defaults)
# Keep AUTO_CREATE_TABLES disabled in app runtime. Use init_db.py for one-time schema setup.
AUTO_CREATE_TABLES=False
ENABLE_STARTUP_SEED=False

# When true, ensures a fixed weak test user on every startup (not recommended for production).
ENABLE_STARTUP_TEST_USER=False

# When true, seeds demo patients, appointments, and sample messages (Guinea-oriented names).
# Recommended for local/staging demos only.
ENABLE_DEMO_CLINIC_SEED=False

# ========================================
# JWT & SECURITY
# ========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: Use strong random value in production!
SECRET_KEY=change-me-in-production-use-strong-random-string

# JWT algorithm (HS256 = HMAC SHA256)
ALGORITHM=HS256

# Token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Reverse proxy that may set X-Forwarded-* (never use * in production)
TRUSTED_PROXY_HOSTS=127.0.0.1,backend

# Shared secret for POST /clinical/reminders/appointments/{id}/respond (required in production)
REMINDER_RESPOND_TOKEN=

# ========================================
# CLINIC BILLING (in-person at reception)
# ========================================
# Payments are collected at reception: cash / Orange Money via
# POST /clinical/billing/charges/{id}/pay
# Legacy portal appointment settlement: admin manual confirm only.

# ========================================
# RATE LIMITING
# ========================================
# Per-IP limits (slowapi). Production defaults: login 30/min, register 5/min.
# Development default login: 120/min (override with RATE_LIMIT_LOGIN).
RATE_LIMIT_LOGIN=120/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_DEFAULT=200/minute

# ========================================
# FRONTEND CONFIGURATION
# ========================================
# For CORS and redirects
# Development:
FRONTEND_URL=http://localhost:5173
FRONTEND_PRODUCTION_URL=https://frontend-seven-rust-94.vercel.app

# Comma-separated extra CORS origins (staging domains, etc.)
# CORS_ORIGINS=https://app.example.com,https://staging.example.com

# ========================================
# EMAIL CONFIGURATION (Optional)
# ========================================
# For sending appointment confirmations, password resets, etc.
# Railway: set SMTP_HOST (or legacy SMTP_SERVER), SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD, SENDER_EMAIL
SMTP_HOST=smtp.gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com

# Gmail: Generate App Password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-specific-password

# Sender email address
SENDER_EMAIL=noreply@santeplatform.com

# ========================================
# LOGGING CONFIGURATION
# ========================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/app.log

# ========================================
# DEPLOYMENT NOTES
# ========================================
# Production: ENVIRONMENT=production, ENABLE_PILOT_SEED=false, PostgreSQL DATABASE_URL.
# See docs/DEPLOYMENT.md for VPS Docker deployment.

# ========================================
# TELECONSULTATION / JITSI
# ========================================
# Option A — local Docker: .\scripts\start_jitsi_dev.ps1 then:
TELECONSULT_PROVIDER=jitsi
JITSI_DOMAIN=127.0.0.1:8443
# Option B — 8x8 JaaS (production):
# JITSI_JAAS=true
# JITSI_APP_ID=vpaas-magic-cookie-xxxxxxxx
# JITSI_KEY_ID=vpaas-magic-cookie-xxxxxxxx/yyyyyyyy
# JITSI_PRIVATE_KEY_PATH=./secrets/jaas-private.pem
# JITSI_DOMAIN=8x8.vc
# Option C — self-hosted JWT (HS256):
# JITSI_APP_ID=your_app_id
# JITSI_APP_SECRET=your_secret

# Enable/disable features for testing/rollout
FEATURE_SMSNOTIFICATIONS=False
FEATURE_VIDEOCONSULTATION=False
FEATURE_INSURANCE_INTEGRATION=False
