# ========================================
# HEALTHCARE PLATFORM - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file with real secrets

# ========================================
# APPLICATION ENVIRONMENT
# ========================================
# Set to True for development only (enables debug mode, verbosity)
DEBUG=False

# Server binding
HOST=0.0.0.0
PORT=8000

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Development (SQLite - easier local setup):
DATABASE_URL=sqlite:///./sante.db

# Production (PostgreSQL - recommended):
# DATABASE_URL=postgresql://username:password@localhost:5432/sante_production

# ========================================
# JWT & SECURITY
# ========================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# IMPORTANT: Use strong random value in production!
SECRET_KEY=change-me-in-production-use-strong-random-string

# JWT algorithm (HS256 = HMAC SHA256)
ALGORITHM=HS256

# Token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ========================================
# STRIPE PAYMENT CONFIGURATION
# ========================================
# Get from https://dashboard.stripe.com/apikeys (Test vs Live mode)

# Stripe Secret Key (never expose publicly)
# Test: sk_test_...
# Live: sk_live_...
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY_HERE

# Stripe Publishable Key (safe to expose in frontend)
# Used by React Stripe Elements component
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY_HERE

# Webhook Signing Secret (from https://dashboard.stripe.com/webhooks)
# Verify webhook authenticity
STRIPE_WEBHOOK_SECRET=whsec_test_YOUR_TEST_WEBHOOK_SECRET_HERE

# ========================================
# FRONTEND CONFIGURATION
# ========================================
# For CORS and redirects
# Development:
FRONTEND_URL=http://localhost:5173
FRONTEND_PRODUCTION_URL=http://localhost:3000

# Production (update with your domain):
# FRONTEND_PRODUCTION_URL=https://yourdomain.com

# ========================================
# EMAIL CONFIGURATION (Optional)
# ========================================
# For sending appointment confirmations, password resets, etc.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com

# Gmail: Generate App Password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-specific-password

# Sender email address
SENDER_EMAIL=noreply@santeplatform.com

# ========================================
# LOGGING CONFIGURATION
# ========================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/app.log

# ========================================
# OPTIONAL: RATE LIMITING
# ========================================
# Limit login attempts to prevent brute force
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=10        # requests per window
RATE_LIMIT_MINUTES=15         # time window in minutes

# ========================================
# OPTIONAL: FEATURE FLAGS
# ========================================
# Enable/disable features for testing/rollout
FEATURE_SMSNOTIFICATIONS=False
FEATURE_VIDEOCONSULTATION=False
FEATURE_INSURANCE_INTEGRATION=False
