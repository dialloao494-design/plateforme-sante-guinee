# Example environment layout (copy to real files as needed):
#
# - `.env.development` — used by `npm run dev` (local API):
#     VITE_API_URL=http://127.0.0.1:8000
#
# - `.env.production` — used by `npm run build` (deployed API):
#     VITE_API_URL=https://your-backend.example.com
#
# Do NOT put VITE_API_URL in a generic `.env` file: it overrides dev settings and
# often causes the browser to call production while you run FastAPI locally.
#
# Vercel / CI: set VITE_API_URL in the hosting dashboard instead of committing secrets.

# Optional: teleconsultation SDK preset for UI labels / future wiring (stub | daily | jitsi | twilio)
# VITE_TELECONSULT_PROVIDER=stub

# Optional websocket endpoint (must be secure in production)
# VITE_WS_URL=wss://your-backend.example.com
