# Pilote GO — copy to .env.pilot (never commit .env.pilot)
# docker compose -f docker-compose.yml -f docker-compose.pilot.yml --env-file .env.pilot up -d --build

DOMAIN=localhost
HTTP_PORT=8088
HTTPS_PORT=9443

POSTGRES_USER=sante
POSTGRES_PASSWORD=CHANGE_ME_PILOT_PG_PASSWORD
POSTGRES_DB=sante

ENVIRONMENT=staging
ENABLE_PILOT_SEED=false
BYPASS_AVAILABILITY_VALIDATION=false

VITE_API_URL=/api
VITE_SAME_ORIGIN_API=true
VITE_TELECONSULT_PROVIDER=jitsi
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
